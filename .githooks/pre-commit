#!/usr/bin/env bash
# Before each commit: the fast checks (seconds, no database), then /review-pr
# on the staged changes (minutes; skip one commit with
# HEIMDALL_SKIP_AI_REVIEW=1). Enable with `make hooks`. CI runs the checks,
# not the AI review, through scripts/check.sh. The fast checks run on a copy
# of the index, so they check what is committed, not unstaged edits.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
snap="$(mktemp -d)"
trap 'rm -rf "$snap"' EXIT
git checkout-index --all --prefix="$snap/"
make -C "$snap" fast
scripts/review-pr.sh
