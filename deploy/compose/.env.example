# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
# The admin key named "bootstrap": hd_ plus 43 base64url characters.
#   echo "hd_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
HEIMDALL_BOOTSTRAP_ADMIN_KEY=
# Encrypts secrets of channels added in the console. Back it up.
#   openssl rand -base64 32
HEIMDALL_SECRET_KEY=
# Optional: a pinned version such as 0.3.2 instead of latest.
HEIMDALL_VERSION=
# Optional: raises GitHub's rate limit for the release watchers.
GITHUB_TOKEN=
